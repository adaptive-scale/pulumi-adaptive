        "jitMode": {
          "type": "string",
          "description": "Which access paths require Just-In-Time approval: session, script, or both."
        },
        "jitMultiApprover": {
          "type": "boolean",
          "description": "Require multiple approvers for Just-In-Time access requests."
        },
        "jitTotalApprovers": {
