{
  "name": "adaptive",
  "displayName": "Adaptive",
  "version": "0.1.0",
  "description": "A Pulumi provider for managing Adaptive (adaptive.live) infrastructure: resources, endpoints, authorizations, groups, and scripts.",
  "keywords": [
    "pulumi",
    "adaptive",
    "access-management",
    "security",
    "category/infrastructure",
    "kind/native"
  ],
  "homepage": "https://adaptive.live",
  "license": "Apache-2.0",
  "repository": "https://github.com/adaptive-scale/pulumi-adaptive",
  "logoUrl": "https://raw.githubusercontent.com/adaptive-scale/pulumi-adaptive/main/assets/logo.png",
  "pluginDownloadURL": "github://api.github.com/adaptive-scale/pulumi-adaptive",
  "publisher": "Adaptive Scale",
  "namespace": "adaptive-scale",
  "language": {
    "csharp": {
      "packageReferences": {
        "Pulumi": "3.*"
      },
      "respectSchemaVersion": true,
      "rootNamespace": "AdaptiveScale"
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/adaptive-scale/pulumi-adaptive/sdk/go/adaptive",
      "respectSchemaVersion": true
    },
    "nodejs": {
      "packageName": "@adaptive-scale/pulumi-adaptive",
      "respectSchemaVersion": true
    },
    "python": {
      "packageName": "pulumi_adaptive",
      "pyproject": {
        "enabled": true
      },
      "respectSchemaVersion": true
    }
  },
  "config": {
    "variables": {
      "serviceToken": {
        "type": "string",
        "description": "Service account token for authenticating with the Adaptive service. If not provided, the provider reads the token from the default adaptive-cli location (~/.adaptive/token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_SVC_TOKEN"
          ]
        },
        "secret": true
      },
      "workspaceUrl": {
        "type": "string",
        "description": "The Adaptive workspace URL. Defaults to https://app.adaptive.live.",
        "default": "https://app.adaptive.live",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_URL"
          ]
        }
      }
    }
  },
  "provider": {
    "properties": {
      "serviceToken": {
        "type": "string",
        "description": "Service account token for authenticating with the Adaptive service. If not provided, the provider reads the token from the default adaptive-cli location (~/.adaptive/token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_SVC_TOKEN"
          ]
        },
        "secret": true
      },
      "workspaceUrl": {
        "type": "string",
        "description": "The Adaptive workspace URL. Defaults to https://app.adaptive.live.",
        "default": "https://app.adaptive.live",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_URL"
          ]
        }
      }
    },
    "inputProperties": {
      "serviceToken": {
        "type": "string",
        "description": "Service account token for authenticating with the Adaptive service. If not provided, the provider reads the token from the default adaptive-cli location (~/.adaptive/token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_SVC_TOKEN"
          ]
        },
        "secret": true
      },
      "workspaceUrl": {
        "type": "string",
        "description": "The Adaptive workspace URL. Defaults to https://app.adaptive.live.",
        "default": "https://app.adaptive.live",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_URL"
          ]
        }
      }
    }
  },
  "resources": {
    "adaptive:index:Authorization": {
      "properties": {
        "description": {
          "type": "string",
          "description": "An optional description of the authorization object."
        },
        "name": {
          "type": "string",
          "description": "The name of the authorization object."
        },
        "permissions": {
          "type": "string",
          "description": "The permission policy. The required format depends on resource_type: structured YAML for postgres/mysql/sqlserver/cockroachdb/yugabytedb (an `allow:` list of database/privileges/objects) and for kubernetes (an RBAC Role manifest); a free-form string for mongodb, ssh, and elasticsearch. Note: the SQL and kubernetes types are validated as YAML server-side, so a bare value like \"SELECT\" is rejected."
        },
        "resourceType": {
          "type": "string",
          "description": "Resource type to grant permission on, e.g. postgres, mysql, mongodb, kubernetes, ssh."
        }
      },
      "required": [
        "name",
        "resourceType",
        "permissions"
      ],
      "inputProperties": {
        "description": {
          "type": "string",
          "description": "An optional description of the authorization object."
        },
        "name": {
          "type": "string",
          "description": "The name of the authorization object."
        },
        "permissions": {
          "type": "string",
          "description": "The permission policy. The required format depends on resource_type: structured YAML for postgres/mysql/sqlserver/cockroachdb/yugabytedb (an `allow:` list of database/privileges/objects) and for kubernetes (an RBAC Role manifest); a free-form string for mongodb, ssh, and elasticsearch. Note: the SQL and kubernetes types are validated as YAML server-side, so a bare value like \"SELECT\" is rejected."
        },
        "resourceType": {
          "type": "string",
          "description": "Resource type to grant permission on, e.g. postgres, mysql, mongodb, kubernetes, ssh."
        }
      },
      "requiredInputs": [
        "name",
        "resourceType",
        "permissions"
      ]
    },
    "adaptive:index:Endpoint": {
      "properties": {
        "authorization": {
          "type": "string",
          "description": "The authorization (by name) to apply to this endpoint."
        },
        "cluster": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "disableOutputCapture": {
          "type": "boolean",
          "description": "Whether to stop retaining terminal output for sessions on this endpoint. Commands are still audited; the recorded output is purged and session replay shows a notice instead. The workspace-level setting is OR'd with this, so leaving it false does not re-enable capture for a workspace that has turned it off."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idleTimeout": {
          "type": "string"
        },
        "isJitEnabled": {
          "type": "boolean",
          "description": "Whether Just-In-Time access approval is enabled."
        },
        "jitApprovers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Emails of users who can approve Just-In-Time access requests."
        },
        "memory": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The name of the endpoint to create."
        },
        "pauseTimeout": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "description": "The resource (by name) this endpoint grants access to."
        },
        "scriptOnlyAccess": {
          "type": "boolean",
          "description": "Whether the endpoint is only accessible via script."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ttl": {
          "type": "string",
          "description": "Time-to-live for the endpoint, e.g. 8h, 7d, 90d."
        },
        "type": {
          "type": "string",
          "description": "The type of session: direct, client, cli, or services.",
          "default": "direct"
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string"
