        },
        "disableOutputCapture": {
          "type": "boolean",
          "description": "Do not retain terminal output for this endpoint. The effective value is OR'd with the workspace-level setting: an endpoint cannot re-enable capture that the workspace disabled."
        },
        "disableWebCli": {
          "type": "boolean",
          "description": "Hide 'Connect via Web CLI' for this endpoint (cli endpoints only)."
        },
        "exposeStatus": {
          "type": "string",
