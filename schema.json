  "resources": {
    "adaptive:index:Authorization": {
      "properties": {
        "description": {
          "type": "string",
          "description": "An optional description of the authorization object."
        },
        "name": {
          "type": "string",
          "description": "The name of the authorization object."
        },
        "permissions": {
          "type": "string",
          "description": "The permission policy. The required format depends on resource_type: structured YAML for postgres/mysql/sqlserver/cockroachdb/yugabytedb (an `allow:` list of database/privileges/objects) and for kubernetes (an RBAC Role manifest); a free-form string for mongodb, ssh, and elasticsearch. Note: the SQL and kubernetes types are validated as YAML server-side, so a bare value like \"SELECT\" is rejected."
        },
        "resourceType": {
          "type": "string",
          "description": "Resource type to grant permission on, e.g. postgres, mysql, mongodb, kubernetes, ssh."
        },
        "status": {
          "type": "string",
          "description": "Current lifecycle status of the authorization."
        }
      },
      "required": [
        "name",
        "resourceType",
        "permissions"
      ],
      "inputProperties": {
        "description": {
          "type": "string",
          "description": "An optional description of the authorization object."
        },
        "name": {
          "type": "string",
          "description": "The name of the authorization object."
        },
        "permissions": {
          "type": "string",
          "description": "The permission policy. The required format depends on resource_type: structured YAML for postgres/mysql/sqlserver/cockroachdb/yugabytedb (an `allow:` list of database/privileges/objects) and for kubernetes (an RBAC Role manifest); a free-form string for mongodb, ssh, and elasticsearch. Note: the SQL and kubernetes types are validated as YAML server-side, so a bare value like \"SELECT\" is rejected."
        },
        "resourceType": {
          "type": "string",
          "description": "Resource type to grant permission on, e.g. postgres, mysql, mongodb, kubernetes, ssh."
        }
      },
      "requiredInputs": [
        "name",
        "resourceType",
        "permissions"
      ]
    },
    "adaptive:index:DataProtection": {
      "properties": {
        "authorizationName": {
          "type": "string",
          "description": "Name of the generated masking authorization (masked_\u003cresource\u003e). Attach it to an Endpoint's `authorization` to serve masked sessions."
        },
        "lastAppliedAt": {
          "type": "string",
          "description": "Last time the policy was applied to the target database."
        },
        "masks": {
          "type": "array",
          "items": {
            "$ref": "#/types/adaptive:index:DataProtectionMask"
          },
          "description": "Masking rules, grouped per database and table."
        },
        "resource": {
          "type": "string",
          "description": "Name of the resource (integration) this masking policy protects. Cannot be changed after creation. Note: creating a policy for a resource that already has one (e.g. configured in the UI) adopts and overwrites it."
        },
        "scoped": {
          "type": "boolean",
          "description": "When true (the default), session users only see the generated masked views. When false, users see everything except the raw masked tables (requires synced metadata)."
        },
        "status": {
          "type": "string",
          "description": "Provisioning status of the policy. Masked views are created lazily at session start."
        }
      },
      "required": [
        "resource"
      ],
      "inputProperties": {
        "masks": {
          "type": "array",
          "items": {
            "$ref": "#/types/adaptive:index:DataProtectionMask"
          },
          "description": "Masking rules, grouped per database and table."
        },
        "resource": {
          "type": "string",
          "description": "Name of the resource (integration) this masking policy protects. Cannot be changed after creation. Note: creating a policy for a resource that already has one (e.g. configured in the UI) adopts and overwrites it."
        },
        "scoped": {
          "type": "boolean",
          "description": "When true (the default), session users only see the generated masked views. When false, users see everything except the raw masked tables (requires synced metadata)."
        }
      },
      "requiredInputs": [
        "resource"
      ]
    },
    "adaptive:index:Endpoint": {
