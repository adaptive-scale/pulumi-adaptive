{
  "name": "adaptive",
  "displayName": "Adaptive",
  "version": "0.2.0",
  "description": "A Pulumi provider for managing Adaptive (adaptive.live) infrastructure: resources, endpoints, authorizations, groups, and scripts.",
  "keywords": [
    "pulumi",
    "adaptive",
    "access-management",
    "security",
    "category/infrastructure",
    "kind/native"
  ],
  "homepage": "https://adaptive.live",
  "license": "Apache-2.0",
  "repository": "https://github.com/adaptive-scale/pulumi-adaptive",
  "logoUrl": "https://raw.githubusercontent.com/adaptive-scale/pulumi-adaptive/main/assets/logo.png",
  "pluginDownloadURL": "github://api.github.com/adaptive-scale/pulumi-adaptive",
  "publisher": "Adaptive Scale",
  "namespace": "adaptive-scale",
  "language": {
    "csharp": {
      "packageReferences": {
        "Pulumi": "3.*"
      },
      "respectSchemaVersion": true,
      "rootNamespace": "AdaptiveScale"
    },
    "go": {
      "generateResourceContainerTypes": true,
      "importBasePath": "github.com/adaptive-scale/pulumi-adaptive/sdk/go/adaptive",
      "respectSchemaVersion": true
    },
    "nodejs": {
      "packageName": "@adaptive-scale/pulumi-adaptive",
      "respectSchemaVersion": true
    },
    "python": {
      "packageName": "pulumi_adaptive",
      "pyproject": {
        "enabled": true
      },
      "respectSchemaVersion": true
    }
  },
  "config": {
    "variables": {
      "serviceToken": {
        "type": "string",
        "description": "Service account token for authenticating with the Adaptive service. If not provided, the provider reads the token from the default adaptive-cli location (~/.adaptive/token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_SVC_TOKEN"
          ]
        },
        "secret": true
      },
      "workspaceUrl": {
        "type": "string",
        "description": "The Adaptive workspace URL. Defaults to https://app.adaptive.live.",
        "default": "https://app.adaptive.live",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_URL"
          ]
        }
      }
    }
  },
  "types": {
    "adaptive:index:DataProtectionColumnMask": {
      "properties": {
        "columnName": {
          "type": "string"
        },
        "maskingType": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "columnName",
        "maskingType"
      ]
    },
    "adaptive:index:DataProtectionMask": {
      "properties": {
        "databaseName": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/types/adaptive:index:DataProtectionTable"
          }
        }
      },
      "type": "object",
      "required": [
        "databaseName"
      ]
    },
    "adaptive:index:DataProtectionTable": {
      "properties": {
        "masked": {
          "type": "boolean"
        },
        "maskedColumns": {
          "type": "array",
          "items": {
            "$ref": "#/types/adaptive:index:DataProtectionColumnMask"
          }
        },
        "schema": {
          "type": "string"
        },
        "tableName": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "tableName"
      ]
    }
  },
  "provider": {
    "properties": {
      "serviceToken": {
        "type": "string",
        "description": "Service account token for authenticating with the Adaptive service. If not provided, the provider reads the token from the default adaptive-cli location (~/.adaptive/token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_SVC_TOKEN"
          ]
        },
        "secret": true
      },
      "workspaceUrl": {
        "type": "string",
        "description": "The Adaptive workspace URL. Defaults to https://app.adaptive.live.",
        "default": "https://app.adaptive.live",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_URL"
          ]
        }
      }
    },
    "inputProperties": {
      "serviceToken": {
        "type": "string",
        "description": "Service account token for authenticating with the Adaptive service. If not provided, the provider reads the token from the default adaptive-cli location (~/.adaptive/token).",
        "default": "",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_SVC_TOKEN"
          ]
        },
        "secret": true
      },
      "workspaceUrl": {
        "type": "string",
        "description": "The Adaptive workspace URL. Defaults to https://app.adaptive.live.",
        "default": "https://app.adaptive.live",
        "defaultInfo": {
          "environment": [
            "ADAPTIVE_URL"
          ]
        }
      }
    }
